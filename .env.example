# Set only after the client approves the canonical production domain.
SITE_URL=https://example.com
# On Vercel production, VERCEL_PROJECT_PRODUCTION_URL is used as a safe
# fallback when SITE_URL is absent. Preview deployments remain noindex.

# Demo records are shown automatically in development and hidden in production.
# Set this only for an explicitly non-public production-mode preview.
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=false

# Public Firebase web configuration. These identify a Firebase project; they
# are not service-account secrets. Use separate values per environment.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only. Never enable this in staging or production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Server-only Firebase Admin configuration. Prefer Application Default
# Credentials on the chosen host. These optional service-account values must
# only be stored in the deployment provider's encrypted environment settings.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The Firebase CLI supplies these automatically to emulator child processes.
# If starting Next separately for local testing, use host:port without a scheme.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# Editorial uploads remain disabled outside emulators until the explicit live
# feature gate, deployed access policy, delivery design and operating limits
# are reviewed and approved. Default validation limit: 10 MiB.
EDITORIAL_MEDIA_MAX_BYTES=10485760
EDITORIAL_MEDIA_MAX_PIXELS=40000000
EDITORIAL_MEDIA_MAX_DIMENSION=12000
EDITORIAL_MEDIA_DAILY_ADMIN_LIMIT=20

# Server-only and deliberately off. Enabling this requires the separate,
# bounded owner-authorized acceptance procedure documented in the audit. The
# environment selector must be exactly staging or production and all three
# target values must match the immutable source-controlled registry.
EDITORIAL_MEDIA_LIVE_ENABLED=false
EDITORIAL_MEDIA_LIVE_ENVIRONMENT=
EDITORIAL_MEDIA_ALLOWED_PROJECT_ID=
EDITORIAL_MEDIA_ALLOWED_BUCKET=

# Customer quote persistence is enabled automatically only when the Firestore
# emulator host is present. Live staging remains fail-closed until the owner
# approves the privacy notice, consent version, retention period and access.
QUOTE_SUBMISSIONS_LIVE_ENABLED=false
QUOTE_LIVE_ENVIRONMENT=
QUOTE_ALLOWED_PROJECT_ID=
QUOTE_ALLOWED_BUCKET=
QUOTE_PRIVACY_APPROVED=true
QUOTE_CONSENT_VERSION=privacy-notice-2026-10-20-v1
QUOTE_RETENTION_DAYS=365
QUOTE_ABUSE_HASH_SECRET=
QUOTE_PHOTO_UPLOADS_LIVE_ENABLED=false
QUOTE_PHOTO_CONSENT_APPROVED=true

# Server-only Gmail SMTP. Create a Google App Password after enabling 2-Step
# Verification. Never commit the password or expose these as NEXT_PUBLIC_*.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kylenagee55@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM=kylenagee55@gmail.com
CONTACT_RECIPIENT_EMAIL=kylenagee55@gmail.com
