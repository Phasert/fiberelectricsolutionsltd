{
  "name": "fes-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node scripts/run-build.mjs",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "node scripts/run-typecheck.mjs",
    "test:security": "vitest run tests/security",
    "test:email": "vitest run tests/email",
    "test:emulators": "firebase emulators:exec --project fes-local --only auth,firestore,storage \"bun run test:security\"",
    "test": "bun run test:emulators",
    "emulators:seed": "node scripts/seed-firebase-emulator.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "nodemailer": "10.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.34.0",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "jose": "4.15.9"
  }
}
